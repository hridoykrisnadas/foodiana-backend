# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
# Local only. On Hostinger (and most managed platforms) the port is assigned for
# you — leave PORT unset there and the app will use whatever it is given.
PORT=4000

# Trust X-Forwarded-For. Keep true behind a load balancer or the rate limiter
# will count every request against the balancer's IP.
TRUST_PROXY=true

# ---- Database (MariaDB) ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=foodiana
DB_PASSWORD=foodiana
DB_NAME=foodiana
DB_POOL_SIZE=10

# ---- Uploads -----------------------------------------------------------------
# Absolute path in production. On Hostinger this MUST live outside the versioned
# build directory, e.g. /home/<user>/domains/api.foodianafest.com/uploads --
# anything inside the app directory is wiped by the next deploy.
UPLOAD_DIR=./uploads

# ---- Staff auth --------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Full dashboard access (visitors, pricing, content).
ADMIN_PASSWORD=Admin1234
# Optional gate-only password: can scan and admit, cannot see the dashboard.
# Leave unset to have gate staff sign in with ADMIN_PASSWORD.
# AGENT_PASSWORD=change-this-agent-password

# ---- CORS --------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---- Rate limits (per replica) -----------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW=10 minutes

# ---- docker compose only -----------------------------------------------------
# Host port the load balancer publishes. Ignored outside `docker compose`.
API_PORT=4000
