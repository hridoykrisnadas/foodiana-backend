# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
# Local only. On Hostinger (and most managed platforms) the port is assigned for
# you — leave PORT unset there and the app will use whatever it is given.
PORT=4000

# Workers to fork when running `npm start` (dist/cluster.js).
#   0 = one worker per CPU core (best for a single big container or a VPS)
#   1 = single process           (best on Hostinger shared hosting, and when
#                                 Kubernetes/ECS/Fly already scales replicas)
# At 1, cluster.js delegates straight to the single-process entry and never forks.
CLUSTER_WORKERS=0

# Trust X-Forwarded-For. Keep true behind a load balancer or the rate limiter
# will count every request against the balancer's IP.
TRUST_PROXY=true

# ---- Supabase ----------------------------------------------------------------
# The service-role key bypasses RLS. It lives ONLY here, never in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Staff auth --------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Full dashboard access (visitors, pricing, content).
ADMIN_PASSWORD=Admin1234
# Optional gate-only password: can scan and admit, cannot see the dashboard.
# Leave unset to have gate staff sign in with ADMIN_PASSWORD.
# AGENT_PASSWORD=change-this-agent-password

# ---- CORS --------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---- Rate limits (per replica) -----------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW=10 minutes
